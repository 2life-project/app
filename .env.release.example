# Ключ App Store Connect API для загрузки сборки в TestFlight.
# Скопировать в .env.release (он в .gitignore) и заполнить.
#
# Где взять: App Store Connect → Users and Access → Integrations →
# App Store Connect API → сгенерировать ключ с ролью App Manager.
# Скачанный AuthKey_XXXXXXXXXX.p8 положить в ~/.appstoreconnect/private_keys/
# (файл скачивается один раз — второй попытки не будет).

ASC_KEY_ID=
ASC_ISSUER_ID=
