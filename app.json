{
  "expo": {
    "name": "2Life",
    "slug": "2life",
    "version": "1.0.0",
    "scheme": "twolife",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f9fafb",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "dev.blackshift.twolife",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "dev.blackshift.twolife",
      "adaptiveIcon": {
        "backgroundColor": "#f9fafb",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": ["android.permission.BLUETOOTH_SCAN", "android.permission.BLUETOOTH_CONNECT"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f9fafb",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Нужен, чтобы найти ваш браслет и забирать с него измерения."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
